# Karutoki — environment variables
# Copy the values into .env.local for local dev, and into
# Vercel → Settings → Environment Variables for the deployed site.

# ---- Supabase (already configured) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# ---- Newsletter letters (Resend — https://resend.com) ----
# 1. Create an API key on the Resend dashboard (API Keys → Create).
# 2. To email readers anywhere (not just yourself): add your own domain in
#    Resend → Domains, add the DNS records it shows, then set RESEND_FROM
#    to an address on that domain. Without a verified domain, the default
#    test sender only delivers to your own account's email.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM="Karutoki <letters@your-domain.com>"

# ---- Site URL (link inside the letters, RSS, sitemap) ----
NEXT_PUBLIC_SITE_URL=https://your-deployed-url.vercel.app
