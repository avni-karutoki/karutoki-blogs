# Karutoki Blogs — local development
#
# Copy this file to `.env.local` and fill in your own values:
#     cp .env.example .env.local
#
# `.env.local` is git-ignored — never commit real keys.

# --- Supabase (required) --------------------------------------------
# Project → Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# --- Site URL -------------------------------------------------------
# Canonical site URL, used for links inside newsletter emails.
# Locally this is http://localhost:3000; in production set it to your
# deployed domain (e.g. https://your-app.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Resend (optional — only needed to email subscribers) ----------
# https://resend.com/api-keys
# RESEND_API_KEY=re_XXXXXXXXXXXXXXXX
#
# Verified sending address. Defaults to the Resend test sender
# ("Karutoki <onboarding@resend.dev>"), which only delivers to your
# own inbox until you verify a domain.
# RESEND_FROM="Karutoki <letters@yourdomain.com>"
